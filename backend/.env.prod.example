# Copy to `.env.prod` and fill in real values. `.env.prod` is git-ignored.
# Used by docker-compose.prod.yml (env_file for the `backend` service).

# REQUIRED: at least 32 bytes. Generate with:  openssl rand -base64 48
JWT_SECRET=

# 900000 = 15 min. Keep short in prod if you add refresh tokens later.
JWT_EXPIRATION_MS=86400000

# The public origin browsers load the app from (used for CORS).
# e.g. https://angkorlance.example.com
FRONTEND_URL=http://localhost

# Where the backend writes uploads inside the container (matches the volume mount).
UPLOAD_DIR=/var/www/images

# Optional: activate a prod Spring profile once one exists (see IMPROVEMENT_PLAN P1-3)
# SPRING_PROFILES_ACTIVE=prod

# --- Optional overrides for docker-compose interpolation (defaults shown) ---
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=angkorlance
