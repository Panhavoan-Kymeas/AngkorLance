# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Secret used to sign/verify JWTs. Must be at least 32 bytes.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Access token lifetime in milliseconds (900000 = 15 min, 86400000 = 24h)
JWT_EXPIRATION_MS=86400000

# Allowed browser origin for CORS (the frontend URL).
# Dev: http://localhost:5173   Prod: https://your-domain
FRONTEND_URL=http://localhost:5173

# Directory where uploaded files are stored.
# Dev: uploads   Prod (container): /var/www/images
UPLOAD_DIR=uploads
